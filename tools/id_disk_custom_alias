import json
from typing import List, Tuple, Optional, Dict, Union, ClassVar
import pyudev
import sys
import os
import re
import subprocess
from argparse import ArgumentParser


def extract_value(pattern: str, text: str) -> Optional[str]:
    s = re.search(pattern, text, flags=re.MULTILINE)
    if s is None:
        return None
    try:
        return s.group(1)
    except IndexError:
        return s.group(0)


def set_env_var(key, value):
    print(f"{key}={value}")


class AliasManager:
    # This is a lookup table for custom alias servers. It maps the chassis size and motherboard product name to a mapping of PCIe port sys_name to the desired alias.
    # The PCIe port sys_name is the address of the pcieport device in the sysfs tree, which can be found by traversing the ancestors of a device by
    # running `udevadm info -a /dev/nvme0n1` and looking for the first ancestor with a driver of "pcieport". These addresses will be different for each motherboard model,
    # but should be consistent for a given motherboard model.
    #
    # Format:
    # Record<
    #   ServerModel,
    #   Record<
    #       MotherboardProductName,
    #       Record<
    #           PCIePortSysName,
    #           Alias
    #       >
    #   >
    LUT_CHASSISSIZE_MOBO_TO_ALIASES: ClassVar = {
        "VM2": {
            "ME03-CE0-000": {
                "0000:40:03.1": "1-1",
                "0000:40:03.2": "1-2",
            },
            "GENOAD8UD-2T/X550": {
                "0000:40:03.3": "1-1",
                "0000:40:03.4": "1-2",
            },
        },
        "E16": {
            "GENOAD8X-2T/BCM": {
                "0000:80:01.1": "1-1",
                "0000:80:01.2": "1-2",
                "0000:80:01.3": "1-3",
                "0000:80:01.4": "1-4",
                "0000:80:03.1": "2-1",
                "0000:80:03.2": "2-2",
                "0000:80:03.3": "2-3",
                "0000:80:03.4": "2-4",
                "0000:c0:01.1": "3-1",
                "0000:c0:01.2": "3-2",
                "0000:c0:01.3": "3-3",
                "0000:c0:01.4": "3-4",
                "0000:c0:03.1": "4-1",
                "0000:c0:03.2": "4-2",
                "0000:c0:03.3": "4-3",
                "0000:c0:03.4": "4-4",
            },
            "TURIND8X-2T/500W": {
                "0000:40:01.2": "1-1",
                "0000:40:01.1": "1-2",
                "0000:40:01.4": "1-3",
                "0000:40:01.3": "1-4",
                "0000:00:01.2": "2-1",
                "0000:00:01.4": "2-2",
                "0000:00:01.1": "2-3",
                "0000:00:01.3": "2-4",
                "0000:c0:01.2": "3-1",
                "0000:c0:01.1": "3-2",
                "0000:c0:01.4": "3-3",
                "0000:c0:01.3": "3-4",
                "0000:80:01.2": "4-1",
                "0000:80:01.1": "4-2",
                "0000:80:01.4": "4-3",
                "0000:80:01.3": "4-4",
            },
        },
        **{
            chassis_size: {
                "TURIND8X-2T/500W": {
                    "0000:80:01.4": "N-1",
                    "0000:80:01.3": "N-2",
                    "0000:80:01.2": "N-3",
                    "0000:80:01.1": "N-4",
                }
            }
            for chassis_size in ("XL60_UBM", "S45_UBM", "Q30_UBM", "AV15_UBM")
        },
    }

    chassis_size: str
    mobo: str

    #  Record<
    #      PCIePortSysName,
    #      Alias
    #  >
    pcieport_alias_lut: Dict[str, str]

    context: pyudev.Context

    def __init__(self):
        self.chassis_size, self.mobo = self._get_chassis_size_and_mobo()
        self.pcieport_alias_lut = self._get_pcieport_alias_lut(
            self.chassis_size, self.mobo
        )
        self.context = pyudev.Context()

    @staticmethod
    def _get_chassis_size_and_mobo() -> Tuple[str, str]:
        try:
            fru = subprocess.check_output(
                ["ipmitool", "fru"], encoding="utf-8", timeout=10.0
            )
            chassis_size = extract_value(r"^\s*Product Part Number\s*:\s*(.*)$", fru)
            mobo = extract_value(r"^\s*Board Product\s*:\s*(.*)$", fru)
            if chassis_size is None or mobo is None:
                raise ValueError("Missing chassis or motherboard in FRU output")
            return chassis_size.strip(), mobo.strip()
        except (
            OSError,  # missing executable, permission errors
            subprocess.CalledProcessError,  # ipmitool returned nonzero
            subprocess.TimeoutExpired,
            UnicodeError,  # output decoding failure
            ValueError,  # expected FRU fields missing
        ):
            with open("/etc/45drives/server_info/server_info.json", "r") as f:
                server_info = json.load(f)
            return server_info["Chassis Size"], server_info["Motherboard"][
                "Product Name"
            ]

    @classmethod
    def _get_pcieport_alias_lut(cls, chassis_size: str, mobo: str) -> Dict[str, str]:
        if chassis_size in cls.LUT_CHASSISSIZE_MOBO_TO_ALIASES:
            # custom aliasing is applicable
            lut_mobo_to_aliases = cls.LUT_CHASSISSIZE_MOBO_TO_ALIASES[chassis_size]
            if mobo in lut_mobo_to_aliases:
                return lut_mobo_to_aliases[mobo]
            else:
                raise NotImplementedError(
                    f"Motherboard unsupported for aliasing {chassis_size}: {mobo}"
                )
        else:
            raise NotImplementedError(
                f"Chassis size not applicable for custom aliasing: {chassis_size}"
            )

    def alias(self, device: Union[str, pyudev.Device]):
        if isinstance(device, str):
            path = device
            sys_path = (
                path
                if path.startswith("/sys")
                else os.path.join("/sys", path.lstrip("/"))
            )
            try:
                device = pyudev.Devices.from_sys_path(self.context, sys_path)
            except pyudev.DeviceNotFoundAtPathError:
                dev_path = (
                    path
                    if path.startswith("/dev")
                    else os.path.join("/dev", path.lstrip("/"))
                )
                device = pyudev.Devices.from_device_file(self.context, dev_path)
            return self.alias(device)
        try:
            pcieport_parent: str = next(
                d for d in device.ancestors if d.driver == "pcieport"
            ).sys_name
        except StopIteration:
            if "nvme" in device.sys_name:
                # special case for NVMe:
                # try stripping down to nvme subsystem device
                nvme_device = pyudev.Devices.from_name(
                    self.context,
                    "nvme",
                    extract_value(r"(nvme\d+)n\d+", device.sys_name),
                )
                try:
                    pcieport_parent = next(
                        d for d in nvme_device.ancestors if d.driver == "pcieport"
                    ).sys_name
                except StopIteration:
                    raise ValueError(
                        f"Drive has no pcieport parents: {device.sys_name}"
                    )
            else:
                raise ValueError(f"Drive has no pcieport parents: {device.sys_name}")
        return self.pcieport_alias_lut[pcieport_parent]

    def alias_from_environment(self):
        return self.alias(pyudev.Devices.from_environment(self.context))

    def list_aliases(self):
        return self.pcieport_alias_lut.values()


def main():
    parser = ArgumentParser()
    parser.add_argument(
        "--list-aliases",
        action="store_true",
        default=False,
        help="Print all custom alias labels and exit",
    )
    parser.add_argument("path", nargs="?", type=str)

    args = parser.parse_args()

    if args.list_aliases:
        print(" ".join(AliasManager().list_aliases()))
        return

    try:
        mgr = AliasManager()
        if args.path:
            alias = mgr.alias(args.path)
        else:
            alias = mgr.alias_from_environment()
        set_env_var("ID_VDEV", alias)
        set_env_var("ID_VDEV_PATH", os.path.join("disk/by-vdev", alias))
        set_env_var("ID_VDEV_ALT_PATH", alias)
    except BaseException as e:
        set_env_var("CUSTOM_ALIAS_ERR", f"{e.__class__.__name__}: {e}")


if __name__ == "__main__":
    main()
